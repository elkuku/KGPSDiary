{% extends 'base.html.twig' %}

{% block title %}{{ tag.name }} - {{ parent() }}{% endblock %}

{% block body %}
    <h2 class="mt-4">{{ 'tag.edit'|trans }}</h2>

    {{ form_start(form) }}
        {{ form_row(form.name) }}
        <button class="btn btn-primary">{{ 'waypoint.save'|trans }}</button>
        <a class="btn btn-link" href="{{ path('app_tag_index') }}">{{ 'waypoint.cancel'|trans }}</a>
    {{ form_end(form) }}
{% endblock %}
