{% extends 'base.html.twig' %}

{% block title %}{{ 'tag.title'|trans }} - {{ parent() }}{% endblock %}

{% block body %}
    <h2 class="mt-4">{{ 'tag.title'|trans }}</h2>
    <p class="text-body-secondary">{{ 'tag.intro'|trans }}</p>

    {% if tags is empty %}
        <p class="text-body-secondary fst-italic">{{ 'tag.none'|trans }}</p>
    {% else %}
        <ul class="list-group mb-4">
            {% for tag in tags %}
                <li class="list-group-item d-flex align-items-center gap-3">
                    <span class="flex-grow-1">{{ tag.name }}</span>
                    <span class="badge text-bg-light">{{ 'waypoint.count'|trans({count: counts[tag.id] ?? 0}) }}</span>
                    <a class="btn btn-sm btn-outline-primary" href="{{ path('app_tag_edit', {id: tag.id}) }}">{{ 'waypoint.edit_short'|trans }}</a>
                    <form method="post" action="{{ path('app_tag_delete', {id: tag.id}) }}"
                          onsubmit="return confirm({{ 'tag.delete_confirm'|trans({name: tag.name})|json_encode|e('html_attr') }});">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-tag-' ~ tag.id) }}">
                        <button class="btn btn-sm btn-outline-danger">{{ 'waypoint.delete'|trans }}</button>
                    </form>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    <h3 class="h5">{{ 'tag.new'|trans }}</h3>
    {{ form_start(form, {attr: {class: 'row g-2 align-items-start'}}) }}
        <div class="col-sm-6">{{ form_row(form.name) }}</div>
        <div class="col-12"><button class="btn btn-primary">{{ 'tag.add'|trans }}</button></div>
    {{ form_end(form) }}
{% endblock %}
