{% extends 'base.html.twig' %}

{% block title %}{{ 'map.title'|trans }} - {{ parent() }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mt-3 mb-2">
        <h2 class="h4 mb-0">{{ 'map.title'|trans }}</h2>
        <a class="btn btn-success btn-sm" href="{{ path('app_waypoint_new') }}">
            <twig:ux:icon name="bi:plus-lg" /> {{ 'waypoint.new'|trans }}
        </a>
    </div>
    <div {{ stimulus_controller('map', {
             token: mapbox_token,
             featuresUrl: path('app_waypoint_features'),
             tracksUrl: path('app_track_features'),
             newUrl: path('app_waypoint_new'),
             center: center,
             labels: {
                 addHere: 'map.add_here'|trans,
                 open: 'map.open'|trans,
                 noToken: 'map.no_token'|trans,
                 loadFailed: 'map.load_failed'|trans,
             },
         }) }}>
        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
            <span class="text-body-secondary small me-auto">{{ 'map.hint'|trans }}</span>
            {% if categories is not empty %}
                <select class="form-select form-select-sm w-auto" aria-label="{{ 'map.filter_category'|trans }}"
                        data-map-target="category" data-action="map#filter">
                    <option value="">{{ 'map.all_categories'|trans }}</option>
                    {% for category in categories %}
                        <option value="{{ category.id }}">{{ category.name }}</option>
                    {% endfor %}
                    <option value="none">{{ 'waypoint.no_category'|trans }}</option>
                </select>
            {% endif %}
            {% if tags is not empty %}
                <select class="form-select form-select-sm w-auto" aria-label="{{ 'map.filter_tag'|trans }}"
                        data-map-target="tag" data-action="map#filter">
                    <option value="">{{ 'map.all_tags'|trans }}</option>
                    {% for tag in tags %}
                        <option value="{{ tag.id }}">{{ tag.name }}</option>
                    {% endfor %}
                </select>
            {% endif %}
            <span class="text-body-secondary small" data-map-target="count"></span>
        </div>
        <div class="waypoint-map rounded border" data-map-target="map"></div>
    </div>
{% endblock %}
