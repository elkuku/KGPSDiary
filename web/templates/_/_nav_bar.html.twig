<!-- Fixed navbar -->
<nav class="navbar navbar-expand-md navbar-dark fixed-top bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="{{ path('app_default') }}">KGPSDiary</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse"
                aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
            <ul class="navbar-nav me-auto mb-2 mb-md-0">
                {% if app.user %}
                    <li class="nav-item">
                        <a class="nav-link{{ app.request.attributes.get('_route') == 'app_waypoint_map' ? ' active' }}" href="{{ path('app_waypoint_map') }}">{{ 'nav.map'|trans }}</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link{{ app.request.attributes.get('_route') == 'app_waypoint_index' ? ' active' }}" href="{{ path('app_waypoint_index') }}">{{ 'nav.waypoints'|trans }}</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link{{ app.request.attributes.get('_route') starts with 'app_category' ? ' active' }}" href="{{ path('app_category_index') }}">{{ 'nav.categories'|trans }}</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link{{ app.request.attributes.get('_route') starts with 'app_tag' ? ' active' }}" href="{{ path('app_tag_index') }}">{{ 'nav.tags'|trans }}</a>
                    </li>
                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item dropdown">
                            <button class="btn btn-dark dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                Admin
                            </button>
                            <ul class="dropdown-menu dropdown-menu-dark">
                                <li><a class="dropdown-item" href="{{ path('app_user_index') }}">Users</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_system_about') }}">About</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_system_logview') }}">Logview</a></li>
                            </ul>
                        </li>
                    {% endif %}
                {% endif %}
            </ul>

            {% if app.user %}
                <div class="dropdown dropstart">
                    <button class="btn btn-dark dropdown-toggle" type="button" id="dropdownMenuButton1"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi-person"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="dropdownMenuButton1">
                        <li><a class="dropdown-item" href="{{ path('app_profile') }}"><i class="bi-person"></i> Profile</a>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li>
                            <a class="dropdown-item" href="{{ path('app_logout') }}" title="Logout">
                                <i class="bi-box-arrow-up-right"></i> Logout
                            </a>
                        </li>
                    </ul>
                </div>
            {% else %}
                <ul class="navbar-nav mb-2 mb-md-0 d-flex">
                    <li class="nav-item">
                        <a class="nav-link" accesskey="l" href="{{ path('app_login') }}" title="Login">
                            <twig:ux:icon name="bi:box-arrow-in-down-right" />
                        </a>
                    </li>
                </ul>
            {% endif %}

            {% include '_/_theme_selector.html.twig' %}

        </div>
    </div>
</nav>
