{% extends 'base.html.twig' %}

{% block body %}
    <h2 class="mt-5">KGPSDiary</h2>
    <p class="lead">{{ 'home.tagline'|trans }}</p>

    {% if app.user %}
        <p>{{ 'home.waypoint_count'|trans({count: waypoint_count}) }}</p>
        <a class="btn btn-primary btn-lg" href="{{ path('app_waypoint_map') }}">
            <twig:ux:icon name="bi:map" /> {{ 'home.open_map'|trans }}
        </a>
    {% else %}
        <a class="btn btn-primary btn-lg" href="{{ path('app_login') }}">{{ 'home.sign_in'|trans }}</a>
    {% endif %}
{% endblock %}
